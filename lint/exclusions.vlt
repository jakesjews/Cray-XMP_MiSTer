`verilator_config

// MiSTer module/file naming, explicitly unused outputs, FPGA power-up values,
// and local names do not need style diagnostics. Keep functional checks enabled.
lint_off -rule DECLFILENAME
lint_off -rule PINCONNECTEMPTY
lint_off -rule PROCASSINIT
lint_off -rule SIMILARNAME
lint_off -rule VARHIDDEN

// Only waive the HPS ports this core does not use. Name each port so that
// accidentally dropping a required connection still produces PINMISSING.
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_0'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_1'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_2'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_3'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_4'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_5'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_0'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_1'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_2'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_3'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_4'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_l_analog_5'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_0'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_1'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_2'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_3'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_4'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_r_analog_5'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_0_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_1_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_2_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_3_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_4_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'joystick_5_rumble'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_0'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_1'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_2'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_3'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_4'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'paddle_5'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_0'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_1'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_2'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_3'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_4'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'spinner_5'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_clk_out'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_data_out'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_clk_in'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_data_in'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_led_status'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_kbd_led_use'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse_clk_out'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse_data_out'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse_clk_in'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse_data_in'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ps2_mouse_ext'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'forced_scandoubler'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'video_rotated'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'new_vmode'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'status_in'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'status_set'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'info_req'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'info'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'img_mounted'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'img_readonly'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'img_size'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_lba'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_blk_cnt'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_rd'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_wr'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_ack'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_buff_addr'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_buff_dout'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_buff_din'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sd_buff_wr'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_index'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_wr'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_addr'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_dout'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_upload'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_upload_req'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_upload_index'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_din'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_rd'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_file_ext'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'ioctl_wait'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'sdram_sz'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'RTC'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'TIMESTAMP'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'uart_mode'"
lint_off -rule PINMISSING -file "Cray1.sv" -match "*Instance has missing pin: 'uart_speed'"

// MiSTer provides wider controls than this core consumes: of the status word
// only the reset, colour, font and aspect ratio bits, and of the buttons only
// the user button.
lint_off -rule UNUSEDSIGNAL -file "Cray1.sv" -match "*Bits of signal are not used: 'status'[127:123,120:15,13:5,2:1]*"
lint_off -rule UNUSEDSIGNAL -file "Cray1.sv" -match "*Bits of signal are not used: 'buttons'[0]*"

// The memory self-test build (SHELL_TEST) replaces the machine and has no use
// for the dead start choice or the CTRL-C pulse.
lint_off -rule UNUSEDSIGNAL -file "Cray1.sv" -match "*Signal is not used: 'rom_boot_cpu'*"
lint_off -rule UNUSEDSIGNAL -file "Cray1.sv" -match "*Signal is not used: 'm_ctrl_c'*"

// The text area is 384 lines at most, so the tenth bit of the line number is
// only set outside it. A character cell is fetched once per column; the pixel
// within the cell comes from the shift register, not from these low bits.
lint_off -rule UNUSEDSIGNAL -file "rtl/terminal/term_video.v" -match "*Bits of signal are not used: 'ly'[9]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/terminal/term_video.v" -match "*Bits of signal are not used: 'fx'[2:0]*"

// Only the memory unit works ahead of the multiplexer; the instruction buffers
// wait for each acknowledge and have no use for take.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray_cpu.v" -match "*Bits of signal are not used: 'mux_take'[0]*"

// A vector length of 0 and of 100 octal both mean 64 elements, so the top bit
// of VL does not change the count. The base address is a 22-bit word address
// carried in a 24-bit register.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/mem_fu.v" -match "*Bits of signal are not used: 'i_vector_length'[6]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/mem_fu.v" -match "*Bits of signal are not used: 'i_data_base_addr'[23:22]*"

// The low bit of a logical opcode picks the scalar or the vector operand,
// which is done before the unit. The double shifts keep one half of a
// 128-bit shift.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/vector_logical.v" -match "*Bits of signal are not used: 'op'[0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/vector_shift.v" -match "*Bits of signal are not used: 'dbl_l'[63:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/vector_shift.v" -match "*Bits of signal are not used: 'dbl_r'[127:64]*"

// Floating point: the arithmetic the manual describes cuts sums and products
// off at fixed bit positions, so the low-order bits below are formed and then
// dropped on purpose. The seed table entries are at most 255.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_mul.v" -match "*Bits of signal are not used: 's4_out'[6:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 'q'[31:8]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 'a1_wide'[27:24,5:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 's6_coef'[47,10:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 's8_sum'[2:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 'rounded'[1:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 'a2'[63:47,14:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/fp_recip.v" -match "*Bits of signal are not used: 'exp_out'[15]*"

// ---- The CPU sources that came from cray-1x ----

// cray_types.vh is a shared header of bus-select constants. Each module that
// includes it uses the ones for its own bus.
lint_off -rule UNUSEDPARAM -file "rtl/cray/cray-1x/cray_types.vh" -match "*"

// The lookup tables and the branch unit take the whole instruction parcel;
// not every field decides every answer. The A scheduler has the ports of the
// S scheduler but no use for the second-parcel flag.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/a_res_lut.v" -match "*Bits of signal are not used: 'i_cip'[8:3]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/s_res_lut.v" -match "*Bits of signal are not used: 'i_cip'[8:6]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/brancher.v" -match "*Bits of signal are not used: 'i_cip'[8]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/a_scheduler.v" -match "*Signal is not used: 'i_lip_vld'*"

// 023 takes the low 24 bits of (Sj). The last stage of the population count
// only adds bits 42 to 63. The double shifts keep one half of a 128-bit shift.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/imm_gen.v" -match "*Bits of signal are not used: 'i_sj'[63:24]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/scalar_pop_lz.v" -match "*Bits of signal are not used: 'sj2'[41:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/scalar_shift.v" -match "*Bits of signal are not used: 'result_d1_l'[63:0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/scalar_shift.v" -match "*Bits of signal are not used: 'result_d1_r'[127:64]*"

// Two inputs of func_top that nothing reads: the instruction buffer's
// whole-word output and a debug input, both from upstream.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Signal is not used: 'i_word_nxt'*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Signal is not used: 'i_debug_full'*"

// Start bit 6 of the vector scheduler belongs to the vector population count,
// an X-MP unit that is not built. The six vector unit trackers have the same
// outputs: only the shift unit needs first and last, only the logical unit
// the last result (for the VM test), and the logical and integer add units
// have no use for the valid flag.
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Bits of signal are not used: 'tk_in_valid'[6,2,0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Bits of signal are not used: 'tk_in_first'[6:2,0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Bits of signal are not used: 'tk_in_last'[6:2,0]*"
lint_off -rule UNUSEDSIGNAL -file "rtl/cray/cray-1x/func_top.v" -match "*Bits of signal are not used: 'tk_out_last'[6:1]*"

// Keep the MiSTer framework out of lint diagnostics while using its real
// module interfaces for elaboration. Generic lint_off covers lint/style
// warnings; the named diagnostics below need explicit exclusions.
lint_off -file "sys/*"
lint_off -rule TIMESCALEMOD -file "sys/*"
lint_off -rule SIMILARNAME -file "sys/*"
lint_off -rule PROCASSWIRE -file "sys/*"
lint_off -rule UNOPTFLAT -file "sys/*"

// The PLL is a port-only boundary, not a behavioral model.
lint_off -file "lint/pll.sv"
lint_off -rule TIMESCALEMOD -file "lint/pll.sv"
