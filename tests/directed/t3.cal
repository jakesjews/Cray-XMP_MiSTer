         IDENT     T3
* Block transfers 034-037: counts 0, 1, 5 and 100 (wrapping past register 77).
TEXIT    =         O'17777762
SRC      =         O'2000
DST      =         O'3000
         ORG       0
         CON       P.START*O'100000000
         CON       0
         CON       O'7777774100000000
         CON       O'0000000030000000000000
         CON       0
         CON       O'7777774000000000
         BSSZ      D'10
         ORG       O'40
* fill SRC..SRC+177 with a pattern: word n = n*3 + 0o1000000
START    A1        0
         A2        D'128
         A3        SRC
         S1        O'1000000
         S2        3
FILL     0,A3      S1
         S1        S1+S2
         A3        A3+1
         A2        A2-1
         A0        A2
         JAN       FILL
* T registers: 100 words into T50.. (wraps to T00), then store them back out
         A0        SRC
         A1        D'100
         T50,A1    0,A0                036
         A0        DST
         ,A0       T50,A1              037
* count 0 moves nothing; count 1 moves one word
         A0        SRC+5
         A1        0
         T10,A1    0,A0
         A1        1
         T11,A1    0,A0
         S3        T10
         S4        T11
         DST+200,0 S3
         DST+201,0 S4
* B registers: 5 words (24 bits each) into B76.. (wraps), and back out
         A0        SRC+10
         A1        5
         B76,A1    0,A0                034
         A0        DST+300
         ,A0       B76,A1              035
         A2        B00
         DST+310,0 A2
         A6        0
         TEXIT,0   A6
HANG     J         HANG
         END
