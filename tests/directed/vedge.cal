* vedge: vector loads off the end of a user's field (see gen_vedge.py).
         INCLUDE "rt_direct.cal"
         INCLUDE "rt_user.cal"
UPKG     =       3000
UBASE    =       20000                   ; the user's field: 20000 to 40000
         TBEGIN
         S1      KFI,0
         U$W1,0  S1
         S1      KFL,0
         U$W2,0  S1
         S1      KFD,0
         U$W4,0  S1
         S1      KFE,0
         U$W5,0  S1
* the last 1000 words of the field hold their relative addresses
         A1      17000
         A2      20000
FILL     S1      A1
         UBASE,A1 S1
         A1      A1+1
         A0      A2-A1
         JAN     FILL
         UGO     KPA
         TPASS
         TEND
KFI      CON     UBASE/40*T$P2_29        ; IBA
KFL      CON     (UBASE+20000)/40*T$P2_29 ; ILA, no interrupt on operand range
KFD      CON     UBASE/40*T$P2_29        ; DBA
KFE      CON     (UBASE+20000)/40*T$P2_29 ; DLA
KPA      CON     (UA-UBASE*4)*T$P2_24    ; P of the user program, relative to the base
         UDATA
*
* the user program; its addresses are relative to UBASE
         ORG     UBASE+10
UA       A1      D'64
         VL      A1
* step 1, 1 elements inside
         A2      D'1
         A0      O'17777
         V1      ,A0,A2
         A0      O'1000
