* vmixed: scalar and vector use of the floating-point units side by side,
* result registers that are their own operands, merges and mask tests behind
* each other; results compared with the model.
         INCLUDE "rt_direct.cal"
         TBEGIN
         A1        D'64
         VL        A1
         A0        VA
         V1        ,A0,1
         A0        VB
         V2        ,A0,1
         V3        V1+V2
         V3        V3+V1
         A0        OUT+D'0
         ,A0,1     V3
         A2        D'4
         S1        V3,A2
         CHKS      S1,D'510,2
         A2        D'5
         S1        V3,A2
         CHKS      S1,D'612,3
         A0        ONE
