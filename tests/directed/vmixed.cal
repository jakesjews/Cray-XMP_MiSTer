         A2        D'9
         S1        V5,A2
         CHKS      S1,X'4002800000000000,6
         A0        FTWO
         A2        0
         V6        ,A0,A2
         V6        /HV6
         A0        OUT+D'320
         ,A0,1     V6
         A0        ZERO
         A2        0
         V7        ,A0,A2
         V3        V4+FV4
         V7        V7+FV3
         A0        OUT+D'384
         ,A0,1     V7
         A0        OUT+D'448
         ,A0,1     V3
         S3        PAT,0
         VM        S3
         A0        VA
         V7        ,A0,1
         V7        V7!V2&VM
         A0        OUT+D'512
         ,A0,1     V7
         A0        VA
         V7        ,A0,1
         V7        V1!V7&VM
         A0        OUT+D'576
         ,A0,1     V7
         A0        VA
         V7        ,A0,1
         S2        D'5
         V7        S2!V7&VM
         A0        OUT+D'640
         ,A0,1     V7
         V3        V1-V2
         VM        V3,M
         S1        VM
         CHKS      S1,X'FFFFFFFFFFFFFFFF,7
         V3        V2-V1
         VM        V3,M
         S1        VM
         CHKS      S1,0,10
         V3        V1+V2
         A1        5
         VL        A1
         V4        V2+V2
         A1        D'64
         VL        A1
         A0        OUT+D'704
         ,A0,1     V3
         A0        OUT+D'768
         ,A0,1     V4
         A3        2
         V3        V1+V2
         V4        V3<A3
         V5        V4&V1
         V6        V5*FV4
         V7        V6+FV5
         V0        /HV7
         A0        OUT+D'832
         ,A0,1     V3
         A0        OUT+D'896
         ,A0,1     V4
         A0        OUT+D'960
         ,A0,1     V5
         A0        OUT+D'1024
         ,A0,1     V6
         A0        OUT+D'1088
         ,A0,1     V7
         A0        OUT+D'1152
         ,A0,1     V0
         A1        D'2
         VL        A1
         V3        V1+V2
         V4        V3<A3
         V5        V4&V1
         V6        V5*FV4
         V7        V6+FV5
         V0        /HV7
         A1        D'64
         VL        A1
         A0        OUT+D'1216
         ,A0,1     V3
         A0        OUT+D'1280
         ,A0,1     V4
         A0        OUT+D'1344
         ,A0,1     V5
         A0        OUT+D'1408
         ,A0,1     V6
