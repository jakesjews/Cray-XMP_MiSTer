         IDENT     VST
         ENTRY     VST
         START     VST
N        =         4096
REP      =         1000
VST      A7        REP
         A5        64
         VL        A5
         A6        1
OUTER    A1        A
         A4        N/64
INNER    A0        A1
         ,A0,A6    V0
         A1        A1+A5
         A4        A4-1
         A0        A4
         JAN       INNER
         A7        A7-1
         A0        A7
         JAN       OUTER
         S0        0
         EX
A        BSS       N
         END
