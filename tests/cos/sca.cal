         IDENT     SCA
         ENTRY     SCA
         START     SCA
N        =         4096
REP      =         1000
SCA      A7        REP
OUTER    A1        0
         A2        N
INNER    S1        A,A1
         S2        B,A1
         S3        S1+S2
         C,A1      S3
         A1        A1+1
         A0        A2-A1
         JAN       INNER
         A7        A7-1
         A0        A7
         JAN       OUTER
         S0        0
         EX
A        BSS       N
B        BSS       N
C        BSS       N
         END
