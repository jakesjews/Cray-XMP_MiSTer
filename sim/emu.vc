// Verilator arguments for the core-level simulation (module emu).
// The HDL file list comes from files.qip (see tools/py/qip2vc.py).
--cc --exe --build -j 0
--top-module emu
-Wno-fatal -Wno-WIDTH -Wno-UNUSED -Wno-PINMISSING -Wno-DECLFILENAME -Wno-PROCASSINIT -Wno-TIMESCALEMOD
-Wno-CASEINCOMPLETE -Wno-CASEX -Wno-BLKSEQ -Wno-UNDRIVEN -Wno-EOFNEWLINE
-O3 --x-assign fast --x-initial fast
-CFLAGS "-O2 -std=c++17"
-I. -Isim/stubs -Irtl/terminal -Irtl/cray/cray-1x
sim/stubs/hps_io.sv
sim/stubs/pll.v
-f sim/build/emu.files
sim/harness/emu_main.cpp
