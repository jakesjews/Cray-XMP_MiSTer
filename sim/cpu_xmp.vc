// Verilator arguments for the CPU-level simulation of the X-MP mode (module cray_cpu, XMP = 1).
--cc --exe --build -j 0
--top-module cray_cpu
-GXMP=1
-Wno-fatal -Wno-WIDTH -Wno-UNUSED -Wno-PINMISSING -Wno-DECLFILENAME -Wno-CASEINCOMPLETE -Wno-CASEX -Wno-BLKSEQ -Wno-UNDRIVEN -Wno-EOFNEWLINE
-O3 --x-assign unique --x-initial unique
-CFLAGS "-O2 -std=c++17 -DCRAY_XMP=1"
-Irtl/cray/cray-1x -y rtl/cray -y rtl/cray/cray-1x
rtl/cray/cray_cpu.v
sim/harness/cpu_main.cpp
