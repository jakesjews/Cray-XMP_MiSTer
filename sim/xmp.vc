// Verilator arguments for the whole X-MP machine: the CPU and the I/O Subsystem (module xmp_machine).
--cc --exe --build -j 0
--top-module xmp_machine
-GCLOCKS_PER_MS=80000
-Wno-fatal -Wno-WIDTH -Wno-UNUSED -Wno-PINMISSING -Wno-DECLFILENAME -Wno-CASEINCOMPLETE -Wno-CASEX -Wno-BLKSEQ -Wno-UNDRIVEN -Wno-EOFNEWLINE -Wno-PINCONNECTEMPTY
-O3 --x-assign unique --x-initial unique
-CFLAGS "-O2 -std=c++17 -DXMP_MACHINE"
-Irtl/cray/cray-1x -y rtl/cray -y rtl/cray/cray-1x -y rtl/ios
rtl/xmp_machine.v
rtl/xmp_bridge.v
sim/harness/ios_main.cpp
