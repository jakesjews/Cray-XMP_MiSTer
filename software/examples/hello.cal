* hello: a complete memory image for the Cray1 core.
*
*     cray1 asm hello.cal -o hello.cry
*
* Load hello.cry from the core's menu.  A memory image starts at word 0
* with the exchange package the dead start loads the registers from; this
* one starts the program in monitor mode with all of memory in its field.
*
CSTA     =       3777760                 ; console status: bit 2**0 input waits, 2**1 output ready
CDAT     =       3777761                 ; console data
P2_24    =       100000000
P2_28    =       2000000000
*
         ORG     0
         CON     START*P2_24             ; P
         CON     0                       ; base address
         CON     777777*P2_28+1*P2_24    ; limit address; mode: monitor
         CON     0                       ; exchange address, vector length, flags
         BSSZ    D'12                    ; A4 to A7 and S0 to S7
*
         ORG     100
START    A1      TEXT                    ; write the text, eight characters to a word
NEXTW    S2      0,A1
         A1      A1+1
         A2      10
NEXTC    S1      S2
         S1      S1>D'56
         S0      S1
         JSZ     ECHO                    ; a zero character ends it
WAIT1    S0      CSTA,0
         S0      S0<D'62
         JSP     WAIT1                   ; wait for output ready
         CDAT,0  S1
         S2      S2<D'8
         A2      A2-1
         A0      A2
         JAN     NEXTC
         J       NEXTW
*
ECHO     S0      CSTA,0                  ; then echo whatever is typed
         S0      S0<D'63
         JSP     ECHO
         S1      CDAT,0
WAIT2    S0      CSTA,0
         S0      S0<D'62
         JSP     WAIT2
         CDAT,0  S1
         S2      15                      ; after a return, start a new line
         S0      S1\S2
         JSN     ECHO
         S1      12
WAIT3    S0      CSTA,0
         S0      S0<D'62
         JSP     WAIT3
         CDAT,0  S1
         J       ECHO
*
TEXT     DATA    'HELLO FROM A CRAY-1.  TYPE SOMETHING: ',0
         END
