* Demonstration 3: Y = A*X + Y for 1024 elements, first one element at a
* time and then with the vector registers, 64 elements at a time.  The
* real-time clock counts the clock periods each loop takes.
SXN      =       2000                    ; 1024 elements
SXX      =       100000                  ; X
SXY      =       102000                  ; Y
SXZ1     =       104000                  ; the scalar result
SXZ2     =       106000                  ; the vector result
*
SAXPY    SAY     MSX1
         R       CRLF
         A5      0
         A6      SXN
SX1      S1      A5                      ; X(I) = I, Y(I) = 2*I + 1
         R       FLOAT
         SXX,A5  S1
         S2      S1+FS1
         S3      1.
         S2      S2+FS3
         SXY,A5  S2
         A5      A5+1
         A0      A5-A6
         JAM     SX1
         S7      KSXA,0                  ; A
* one element at a time
         S5      RT
         A5      0
SX2      S1      SXX,A5
         S2      SXY,A5
         S1      S7*FS1
         S1      S1+FS2
         SXZ1,A5 S1
         A5      A5+1
         A0      A5-A6
         JAM     SX2
         S6      RT
         S5      S6-S5
         SAY     MSX2
         S1      S5
         R       PUTDEC
         SAY     MSX4
         R       CRLF
* 64 elements at a time
         A1      100
         VL      A1
         S5      RT
         A5      0
SX3      A1      SXX
         A0      A1+A5
         V1      ,A0,1
         A1      SXY
         A0      A1+A5
         V2      ,A0,1
         V3      S7*FV1
         V4      V3+FV2
         A1      SXZ2
         A0      A1+A5
         ,A0,1   V4
         A1      100
         A5      A5+A1
         A0      A5-A6
         JAM     SX3
         S6      RT
         S5      S6-S5
         SAY     MSX3
         S1      S5
         R       PUTDEC
         SAY     MSX4
         R       CRLF
* the two results must be the same
         A5      0
         A7      0
SX4      S1      SXZ1,A5
         S2      SXZ2,A5
         S0      S1\S2
         JSZ     SX5
         A7      A7+1
SX5      A5      A5+1
         A0      A5-A6
         JAM     SX4
         S1      A7
         R       PUTDEC
         SAY     MSX5
         R       CRLF
         SAY     MSX6
         S1      SXZ2+D'1000,0
         R       PUTFLT
         R       CRLF
SXX9     EX
         J       SXX9
KSXA     CON     X'4002C00000000000      ; 3.0
MSX1     DATA    'Y = 3*X + Y FOR 1024 ELEMENTS',0
MSX2     DATA    'SCALAR LOOP  ',0
MSX3     DATA    'VECTOR LOOP  ',0
MSX4     DATA    ' CLOCK PERIODS',0
MSX5     DATA    ' ELEMENTS DIFFER',0
MSX6     DATA    'Y(1001) = ',0
