* Demonstration 2: the Mandelbrot set, a row of 64 points at a time in the
* vector registers.  The vector mask marks the points that have not left
* the circle of radius 2 yet; only those go on changing.
*
*     V1  real part of each point         V2, V3  real and imaginary part of z
*     V4  iterations each point lasted    S5      imaginary part of the row
MANDEL   A1      100
         VL      A1
         S1      KMX0,0
         S2      KMDX,0
         A5      0
MB1      V1,A5   S1
         S1      S1+FS2
         A5      A5+1
         A0      A5-A1
         JAM     MB1
         S5      KMY0,0
         A7      D'21                    ; rows
MB2      V2      0
         V3      0
         V4      0
         S4      4.
         S6      1
         A6      D'40                    ; iterations
MB3      V5      V2*FV2
         V6      V3*FV3
         V7      V5+FV6
         V0      S4-FV7                  ; 4 - |z|**2
         VM      V0,P
         S0      VM
         JSZ     MB4                     ; every point has left
         V7      V2*FV3
         V0      V7+FV7
         V7      S5+FV0                  ; the new imaginary part
         V0      V7!V3&VM
         V3      V0
         V7      V5-FV6
         V5      V7+FV1                  ; the new real part
         V6      V5!V2&VM
         V2      V6
         V5      0
         V6      S6!V5&VM                ; 1 for each point still inside
         V7      V4+V6
         V4      V7
         A6      A6-1
         A0      A6
         JAN     MB3
MB4      S1      40
         A5      10
MB5      OUTCH
         A5      A5-1
         A0      A5
         JAN     MB5
         A5      0
MB6      S1      V4,A5
         S1      S1>D'2
         A2      S1
         S1      KMCH,A2
         OUTCH
         A5      A5+1
         A1      100
         A0      A5-A1
         JAM     MB6
         R       CRLF
         S2      KMDY,0
         S5      S5+FS2
         A7      A7-1
         A0      A7
         JAN     MB2
MBX      EX
         J       MBX
KMX0     CON     X'C002800000000000      ; -2.0
KMDX     CON     X'3FFCA00000000000      ; 5/128
KMY0     CON     X'C0018C0000000000      ; -35/32
KMDY     CON     X'3FFDE00000000000      ; 7/64
KMCH     CON     40,56,72,55,75,53,52,43,45,46,100
