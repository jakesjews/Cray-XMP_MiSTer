* CRAY-1 monitor for the MiSTer core.
*
* Dead start copies this program into memory from word 0 and exchanges to
* the package at word 0.  The monitor runs in monitor mode and talks to the
* console through the core's I/O page.  A program started with G, or one of
* the demonstration programs, runs as a job: a user-mode exchange package
* at word 20 with base address 0 and the largest limit address.  An exit,
* an error or CTRL-C on the console exchanges back to the monitor.
*
* Commands (numbers are octal)
*
*     E addr (count)     examine memory
*     D addr value ...   deposit into memory
*     G addr             start a job at word addr
*     C                  continue the job
*     R                  show the registers of the job
*     1 to 7             demonstration programs
*     ? or H             help
*
* Subroutines are called with R and return with J B00.  Unless noted they
* use only A0 to A4 and S0 to S4, so a caller can keep values in A5 to A7
* and S5 to S7.  Jobs call them too.
*
CSTA     =       3777760                 ; console status
CDAT     =       3777761                 ; console data
P2_24    =       100000000
P2_28    =       2000000000
P2_40    =       20000000000000
LAMAX    =       777777
UPKG     =       20                      ; the exchange package of the job
LMAX     =       D'72                    ; longest command line
*
* Write the character in S1.  Clobbers S0.
         MACRO   OUTCH
         LOCAL   %W
%W       S0      CSTA,0                  ; wait for output ready, bit 2**1
         S0      S0<D'62
         JSP     %W
         CDAT,0  S1
         ENDM
*
* Write the string at a label.
         MACRO   SAY %TEXT
         A1      %TEXT
         R       PUTS
         ENDM
*
* Go to %TO if the character in S1 is %C.  Clobbers S0, S2.
         MACRO   CASE %C,%TO
         S2      %C
         S0      S1\S2
         JSZ     %TO
         ENDM
*
* ---- the dead start exchange package
         ORG     0
         CON     START*P2_24             ; P
         CON     0                       ; BA
         CON     LAMAX*P2_28+1*P2_24     ; LA, monitor mode
         CON     UPKG/20*P2_40           ; XA
         BSSZ    D'12
         ORG     UPKG
         BSSZ    20
*
         ORG     100
START    SAY     MBANNR
         R       CRLF
         SAY     MHINT
         R       CRLF
         S1      IDLE                    ; until a job is started, C runs this
         R       MKJOB
*
* ---- read a command line
PROMPT   S1      76                      ; >
         OUTCH
         S1      40
         OUTCH
         A5      0
RDL      S0      CSTA,0                  ; bit 2**0: an input character waits
         S0      S0<D'63
         JSP     RDL
         S1      CDAT,0
         CASE    15,RDLEND               ; return
         CASE    12,RDL                  ; line feed
         CASE    10,RDLBS                ; backspace
         CASE    177,RDLBS               ; delete
         S2      40
         S0      S1-S2
         JSM     RDL                     ; other control characters
         S2      141
         S0      S1-S2
         JSM     RDL1
         S2      173
         S0      S1-S2
         JSP     RDL1
         S2      40
         S1      S1-S2                   ; lower case to upper case
RDL1     A1      LMAX
         A0      A5-A1
         JAP     RDL                     ; the line is full
         LBUF,A5 S1
         A5      A5+1
         OUTCH
         J       RDL
RDLBS    A0      A5
         JAZ     RDL
         A5      A5-1
         S1      10
         OUTCH
         S1      40
         OUTCH
         S1      10
         OUTCH
         J       RDL
RDLEND   S1      0
         LBUF,A5 S1
         R       CRLF
*
* ---- find the command
         A5      0
         R       SKIPB
         S0      S1
         JSZ     PROMPT
         A5      A5+1
         CASE    105,CMDE                ; E
         CASE    104,CMDD                ; D
         CASE    107,CMDG                ; G
         CASE    103,CMDC                ; C
         CASE    122,CMDR                ; R
         CASE    77,CMDH                 ; ?
         CASE    110,CMDH                ; H
         CASE    61,DEMO1
         CASE    62,DEMO2
         CASE    63,DEMO3
         CASE    64,DEMO4
         CASE    65,DEMO5
         CASE    66,DEMO6
         CASE    67,DEMO7
WHAT     SAY     MWHAT
         R       CRLF
         J       PROMPT
*
CMDH     A6      0
CMDH1    A1      KHELP,A6
         A0      A1
         JAZ     PROMPT
         R       PUTS
         R       CRLF
         A6      A6+1
         J       CMDH1
*
* ---- E addr (count)
CMDE     R       GETNUM
         A0      A2
         JAZ     WHAT
         A6      S1
         R       GETNUM
         A7      S1
         A0      A2
         JAN     CMDE1
         A7      10                      ; eight words when no count is given
CMDE1    A0      A7
         JAZ     PROMPT
         S1      A6
         A2      7
         R       PUTOCN
         S1      40
         OUTCH
         OUTCH
         S1      0,A6
         R       PUTO22
         S1      40
         OUTCH
         OUTCH
         S4      0,A6
         A4      10
CMDE2    S1      S4
         S1      S1>D'56
         S2      40
         S0      S1-S2
         JSM     CMDE3
         S2      177
         S0      S1-S2
         JSM     CMDE4
CMDE3    S1      56                      ; a point for what cannot be printed
CMDE4    OUTCH
         S4      S4<D'8
         A4      A4-1
         A0      A4
         JAN     CMDE2
         R       CRLF
         A6      A6+1
         A7      A7-1
         J       CMDE1
*
* ---- D addr value ...
CMDD     R       GETNUM
         A0      A2
         JAZ     WHAT
         A6      S1
CMDD1    R       GETNUM
         A0      A2
         JAZ     PROMPT
         0,A6    S1
         A6      A6+1
         J       CMDD1
*
* ---- G addr
CMDG     R       GETNUM
         A0      A2
         JAZ     WHAT
         S1      S1<D'2                  ; word address to parcel address
         J       NEWJOB
*
DEMO1    S1      SIEVE
         J       NEWJOB
DEMO2    S1      MANDEL
         J       NEWJOB
DEMO3    S1      SAXPY
         J       NEWJOB
DEMO4    S1      MATRIX
         J       NEWJOB
DEMO5    S1      DIVIDE
         J       NEWJOB
DEMO6    S1      ECHO
         J       NEWJOB
DEMO7    S1      MEMTST
         J       NEWJOB
*
* ---- start a job at the parcel address in S1, or continue the job
NEWJOB   R       MKJOB
CMDC     A1      UPKG
         XA      A1
         S1      1
         CSTA,0  S1                      ; CTRL-C interrupts the job
         EX
* The job has stopped and its registers are in the package.
         S1      0
         CSTA,0  S1
         S5      UPKG+3,0                ; the flags are bits 31 to 39 from the left
         S0      S5<D'31
         JSM     JCON
         S0      S5<D'33
         JSM     JFPE
         S0      S5<D'34
         JSM     JORE
         S0      S5<D'35
         JSM     JPRE
         S0      S5<D'38
         JSM     JERR
         A1      MNEX
         J       JEND
JCON     S0      CSTA,0                  ; drop what was typed
         S0      S0<D'63
         JSP     JCON1
         S1      CDAT,0
         J       JCON
JCON1    R       CRLF
         A1      MCON
         J       JEND
JFPE     R       CRLF
         A1      MFPE
         J       JEND
JORE     R       CRLF
         A1      MORE
         J       JEND
JPRE     R       CRLF
         A1      MPRE
         J       JEND
JERR     A1      MEEX
JEND     R       PUTS
         SAY     MATP
         R       PUTP
         R       CRLF
         S1      UPKG+3,0                ; clear the flags so that C can go on
         S2      KFMASK,0
         S1      #S2&S1
         UPKG+3,0 S1
         J       PROMPT
*
* ---- R
CMDR     SAY     MP
         R       PUTP
         SAY     MVL
         S1      UPKG+3,0
         S1      S1>D'33
         S2      177
         S1      S1&S2
         A2      3
         R       PUTOCN
         R       CRLF
         A6      0
CMDR1    S1      101                     ; A
         OUTCH
         S1      A6
         S2      60
         S1      S1+S2
         OUTCH
         S1      40
         OUTCH
         S1      UPKG,A6
         S1      S1<D'40
         S1      S1>D'40
         A2      10
         R       PUTOCN
         S1      40
         OUTCH
         OUTCH
         A6      A6+1
         A1      4
         A0      A6-A1
         JAN     CMDR2
         R       CRLF
CMDR2    A1      10
         A0      A6-A1
         JAN     CMDR1
         R       CRLF
         A6      0
CMDR3    S1      123                     ; S
         OUTCH
         S1      A6
         S2      60
         S1      S1+S2
         OUTCH
         S1      40
         OUTCH
         S1      UPKG+10,A6
         R       PUTO22
         S1      40
         OUTCH
         OUTCH
         A6      A6+1
         S1      A6
         S0      S1<D'63
         JSM     CMDR4
         R       CRLF
CMDR4    A1      10
         A0      A6-A1
         JAN     CMDR3
         J       PROMPT
*
* The job that C continues before any other has been started.
IDLE     EX
         J       IDLE
*
* =====================================================================
* Subroutines
* =====================================================================
*
* MKJOB: build the package of a new job that starts at the parcel address
* in S1: user mode, base address 0, the largest limit address, all
* registers zero.
MKJOB    S2      0
         A1      UPKG
         A2      20
MKJOB1   0,A1    S2
         A1      A1+1
         A2      A2-1
         A0      A2
         JAN     MKJOB1
         S1      S1<D'24
         UPKG,0  S1
         S1      KLA,0
         UPKG+2,0 S1
         S1      KXA,0
         UPKG+3,0 S1
         J       B00
*
* PUTC: write the character in S1.
PUTC     OUTCH
         J       B00
*
* CRLF: start a new line.
CRLF     S1      15
         OUTCH
         S1      12
         OUTCH
         J       B00
*
* PUTS: write the string at the address in A1.  Characters are packed
* eight to a word and a zero character ends the string.
PUTS     S2      0,A1
         A1      A1+1
         A2      10
PUTS1    S1      S2
         S1      S1>D'56
         S0      S1
         JSZ     PUTS9
         OUTCH
         S2      S2<D'8
         A2      A2-1
         A0      A2
         JAN     PUTS1
         J       PUTS
PUTS9    J       B00
*
* PUTO22: write (S1) as 22 octal digits.
PUTO22   S2      S1
         S1      S2
         S1      S1>D'63
         S3      60
         S1      S1+S3
         OUTCH
         S2      S2<D'1
         A2      25
         J       PUTOC1
*
* PUTOCN: write the low (A2) octal digits of (S1), A2 from 1 to 25 octal.
PUTOCN   S2      S1
         A3      3
         A3      A2*A3
         A4      100
         A3      A4-A3
         S2      S2<A3                   ; the first digit is on top
PUTOC1   S1      S2
         S1      S1>D'61
         S3      60
         S1      S1+S3
         OUTCH
         S2      S2<D'3
         A2      A2-1
         A0      A2
         JAN     PUTOC1
         J       B00
*
* PUTDEC: write the integer in S1 in decimal.
PUTDEC   S2      S1
         S0      S2
         JSP     PUTD1
         S2      -S2
         S1      55                      ; minus
         OUTCH
PUTD1    A1      KPTEN
         A3      0                       ; not zero once a digit is out
PUTD2    S3      0,A1
         S0      S3
         JSZ     PUTD6
         A2      0
PUTD3    S0      S2-S3
         JSM     PUTD4
         S2      S2-S3
         A2      A2+1
         J       PUTD3
PUTD4    A0      A2+A3
         JAZ     PUTD5                   ; a leading zero
         A3      A3+1
         S1      A2
         S4      60
         S1      S1+S4
         OUTCH
PUTD5    A1      A1+1
         J       PUTD2
PUTD6    S4      60
         S1      S2+S4
         OUTCH
         J       B00
*
* SKIPB: move A5 to the next character of the command line that is not a
* blank and leave that character in S1.
SKIPB    S1      LBUF,A5
         S2      40
         S0      S1\S2
         JSN     SKIPB9
         A5      A5+1
         J       SKIPB
SKIPB9   J       B00
*
* GETNUM: read an octal number from the command line at A5 into S1.
* A2 is the number of digits read; 0 means there was no number.
GETNUM   S3      0
         A2      0
GETN0    S1      LBUF,A5
         S2      40
         S0      S1\S2
         JSN     GETN1
         A5      A5+1
         J       GETN0
GETN1    S1      LBUF,A5
         S2      60
         S1      S1-S2
         S0      S1
         JSM     GETN9
         S2      10
         S0      S1-S2
         JSP     GETN9
         S3      S3<D'3
         S3      S3!S1
         A2      A2+1
         A5      A5+1
         J       GETN1
GETN9    S1      S3
         J       B00
*
* PUTP: write the P of the job as a word address and a parcel letter.
* Uses B01.
PUTP     A1      B00
         B01     A1
         S1      UPKG,0
         S1      S1>D'26
         A2      7
         R       PUTOCN
         S1      UPKG,0
         S1      S1>D'24
         S2      3
         S1      S1&S2
         S2      101
         S1      S1+S2
         OUTCH
         J       B01
*
* FLOAT: the integer in S1, 0 to 2**47-1, as a floating-point number.
FLOAT    S2      KFLEXP,0
         S1      S1!S2
         S1      +FS1
         J       B00
*
* FIX: the integer part of the positive floating-point number in S1.
FIX      S2      S1
         S2      S2<D'1
         S2      S2>D'49                 ; the exponent
         A3      S2
         A4      40060
         A3      A4-A3                   ; places to shift the coefficient right
         S1      S1<D'16
         S1      S1>D'16
         S1      S1>A3
         J       B00
*
* PUTFLT: write the floating-point number in S1 with six decimals.
* Uses T70, T71, B76 and B77 as well.
PUTFLT   A3      B00
         B77     A3
         S0      S1
         JSP     PUTF1
         S1      -FS1
         T70     S1
         S1      55                      ; minus
         OUTCH
         S1      T70
PUTF1    S2      KROUND,0
         S1      S1+FS2
         T70     S1
         R       FIX
         T71     S1
         R       PUTDEC
         S1      56                      ; point
         OUTCH
         S1      T71
         R       FLOAT
         S2      T70
         S1      S2-FS1                  ; the fraction
         T70     S1
         A2      6
         B76     A2
PUTF2    S1      T70
         S2      KTEN,0
         S1      S1*FS2
         T70     S1
         R       FIX
         T71     S1
         S2      60
         S1      S1+S2
         OUTCH
         S1      T71
         R       FLOAT
         S2      T70
         S1      S2-FS1
         T70     S1
         A2      B76
         A2      A2-1
         B76     A2
         A0      A2
         JAN     PUTF2
         J       B77
*
* =====================================================================
* Demonstration programs
* =====================================================================
         INCLUDE "sieve.cal"
         INCLUDE "mandel.cal"
         INCLUDE "saxpy.cal"
         INCLUDE "matrix.cal"
         INCLUDE "divide.cal"
         INCLUDE "echo.cal"
         INCLUDE "memtest.cal"
*
* =====================================================================
* Constants and text
* =====================================================================
KLA      CON     LAMAX*P2_28             ; LA; user mode
KXA      CON     UPKG/20*P2_40           ; XA; VL = 0; no flags
KFMASK   CON     777*P2_24
KFLEXP   CON     X'4030000000000000      ; exponent 40060, coefficient 0
KTEN     CON     X'4004A00000000000      ; 10.0
KROUND   CON     X'3FEC8637BD05AF6C      ; 0.0000005
KPTEN    CON     D'100000000000000
         CON     D'10000000000000
         CON     D'1000000000000
         CON     D'100000000000
         CON     D'10000000000
         CON     D'1000000000
         CON     D'100000000
         CON     D'10000000
         CON     D'1000000
         CON     D'100000
         CON     D'10000
         CON     D'1000
         CON     D'100
         CON     D'10
         CON     0
*
KHELP    CON     MH1
         CON     MH2
         CON     MH3
         CON     MH4
         CON     MH5
         CON     MH6
         CON     MH7
         CON     MH8
         CON     0
MBANNR   DATA    'CRAY-1 MONITOR',0
MHINT    DATA    'TYPE ? FOR HELP',0
MWHAT    DATA    'WHAT?',0
MH1      DATA    ' E ADDR (COUNT)    EXAMINE MEMORY',0
MH2      DATA    ' D ADDR VALUE ...  DEPOSIT INTO MEMORY',0
MH3      DATA    ' G ADDR            START A PROGRAM AT ADDR',0
MH4      DATA    ' C                 CONTINUE THE PROGRAM',0
MH5      DATA    ' R                 REGISTERS OF THE PROGRAM',0
MH6      DATA    ' 1 SIEVE   2 MANDELBROT   3 SAXPY   4 MATRIX',0
MH7      DATA    ' 5 DIVIDE  6 ECHO         7 MEMORY TEST',0
MH8      DATA    ' NUMBERS ARE OCTAL.  CTRL-C STOPS A PROGRAM.',0
MNEX     DATA    'NORMAL EXIT',0
MEEX     DATA    'ERROR EXIT',0
MCON     DATA    'CONSOLE INTERRUPT',0
MFPE     DATA    'FLOATING POINT ERROR',0
MORE     DATA    'OPERAND RANGE ERROR',0
MPRE     DATA    'PROGRAM RANGE ERROR',0
MATP     DATA    '  P ',0
MP       DATA    'P ',0
MVL      DATA    '  VL ',0
*
LBUF     BSS     LMAX+2                  ; the command line, one character a word
         END
