* Demonstration 4: the product of two 64 by 64 matrices, a row of the
* result at a time in the vector registers.
*
*     A(I,K) = I + K      B(K,J) = K - J      I, J, K from 0 to 63
*     C(I,J) = sum over K of A(I,K) * B(K,J)
*
* C(0,0) is 85344 and C(63,63) is -168672.
MXF      =       107000                  ; the numbers 0.0 to 63.0
MXA      =       110000
MXB      =       120000
MXC      =       130000
*
MATRIX   SAY     MMX1
         R       CRLF
         A1      100
         VL      A1
         A5      0
         A6      100
MX1      S1      A5
         R       FLOAT
         MXF,A5  S1
         A5      A5+1
         A0      A5-A6
         JAM     MX1
* fill A and B a row at a time
         A0      MXF
         V1      ,A0,1
         A5      0                       ; row
         A7      0                       ; offset of the row
MX2      S1      MXF,A5
         V2      S1+FV1
         V3      S1-FV1
         A1      MXA
         A0      A1+A7
         ,A0,1   V2
         A1      MXB
         A0      A1+A7
         ,A0,1   V3
         A7      A7+A6
         A5      A5+1
         A0      A5-A6
         JAM     MX2
* multiply
         S5      RT
         A5      0                       ; I
         A7      0                       ; offset of row I
MX3      V3      0                       ; the row of C
         A4      0                       ; K
         A3      MXB                     ; row K of B
MX4      A1      MXA
         A1      A1+A7
         A1      A1+A4
         S1      0,A1                    ; A(I,K)
         A0      A3
         V1      ,A0,1
         V2      S1*FV1
         V4      V3+FV2
         A3      A3+A6
         A4      A4+1
         A1      MXA
         A1      A1+A7
         A1      A1+A4
         S1      0,A1                    ; A(I,K+1)
         A0      A3
         V1      ,A0,1
         V2      S1*FV1
         V3      V4+FV2
         A3      A3+A6
         A4      A4+1
         A0      A4-A6
         JAM     MX4
         A1      MXC
         A0      A1+A7
         ,A0,1   V3
         A7      A7+A6
         A5      A5+1
         A0      A5-A6
         JAM     MX3
         S6      RT
         S5      S6-S5
         SAY     MMX2
         S1      MXC,0
         R       PUTFLT
         R       CRLF
         SAY     MMX3
         S1      MXC+7777,0
         R       PUTFLT
         R       CRLF
         S1      S5
         R       PUTDEC
         SAY     MMX4
         R       CRLF
MXX      EX
         J       MXX
MMX1     DATA    'PRODUCT OF TWO 64 BY 64 MATRICES',0
MMX2     DATA    'C(1,1)   = ',0
MMX3     DATA    'C(64,64) = ',0
MMX4     DATA    ' CLOCK PERIODS',0
