* Demonstration 1: the sieve of Eratosthenes for the primes below 1000.
SVN      =       D'1000
SVF      =       100000                  ; one word for each number
*
SIEVE    SAY     MSV1
         R       CRLF
         A5      0
         S5      0
         A6      SVN
SV1      SVF,A5  S5
         A5      A5+1
         A0      A5-A6
         JAM     SV1
         A5      2                       ; the candidate
         A7      0                       ; primes found
         S7      1
         S6      17                      ; primes left on this line
SV2      S1      SVF,A5
         S0      S1
         JSN     SV7                     ; crossed out
         A7      A7+1
         S1      40                      ; right-justified in five columns
         OUTCH
         OUTCH
         A1      D'100
         A0      A5-A1
         JAP     SV3
         OUTCH
SV3      A1      D'10
         A0      A5-A1
         JAP     SV4
         OUTCH
SV4      S1      A5
         R       PUTDEC
         S6      S6-S7
         S0      S6
         JSN     SV5
         R       CRLF
         S6      17
SV5      A1      A5+A5                   ; cross out the multiples
SV6      A0      A1-A6
         JAP     SV7
         SVF,A1  S7
         A1      A1+A5
         J       SV6
SV7      A5      A5+1
         A0      A5-A6
         JAM     SV2
         R       CRLF
         S1      A7
         R       PUTDEC
         SAY     MSV2
         R       CRLF
SVX      EX
         J       SVX
MSV1     DATA    'PRIMES BELOW 1000',0
MSV2     DATA    ' PRIMES',0
